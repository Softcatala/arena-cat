# Copy this file to .env and adjust the values. The real .env is not versioned.

# PostgreSQL host and port
DB_HOST=127.0.0.1
POSTGRES_PORT=5432

# Superuser: manages the schema, runs the migrations and the tests.
POSTGRES_USER=arena_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=arena_cat

# Application role with limited permissions: used by the service.
APP_DB_USER=arena_app
APP_DB_PASSWORD=change_this_app_password

# Hugging Face API token
HF_TOKEN=hf_your_token_here

# Optional: where downloaded Hugging Face models (and other data) are stored
# HF_HOME=.hf-cache

# HMAC
HMAC_SECRET_KEY=clau_secreta_hmac
EMAIL_HASH_PEPPER=pepper_email_hash
SESSION_SECRET=clau_token_sessio

# Session cookie / authentication
# Require email verification before login/task access. When true, new users must
# confirm their address with a link sent by email (see the SMTP settings below).
REQUIRE_EMAIL_VERIFICATION=false
# Seconds to wait before the verification email can be resent to the same account.
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Same for the password reset email.
PASSWORD_RESET_COOLDOWN_SECONDS=60
# Duration of the session (and cookie) in hours.
SESSION_TTL_HOURS=24
# Name of the session cookie.
COOKIE_NAME=session_token
# Set to true in production behind HTTPS so the cookie is only sent over TLS.
# Keep false only for local HTTP development.
COOKIE_SECURE=false
# SameSite policy: lax (default), strict, or none.
COOKIE_SAMESITE=lax

# FastAPI
API_PORT=8000

# SMTP server for transactional email (verification links). With SMTP_HOST empty
# nothing is sent: the message, link included, is written to the backend log.
SMTP_HOST=
SMTP_PORT=587
# starttls (usually port 587), ssl (usually port 465) or none (local test servers only).
SMTP_SECURITY=starttls
# Credentials are used only if the server offers AUTH; otherwise the email is sent
# without logging in and a warning is written to the log.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=arena@softcatala.org
EMAIL_FROM_NAME=Arena Cat
# Public URL of the frontend, used to build the links in emails.
FRONTEND_BASE_URL=http://localhost:5173
